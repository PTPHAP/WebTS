+async fn open_file_stream(addr: SocketAddr, key: String) -> Result<TcpStream> {
+	if key.len() > 256 || key.is_empty() {
+		return Err(Error::FiletransferIo(std::io::Error::other("invalid file transfer key")));
 	}
+	tokio::time::timeout(Duration::from_secs(5), async move {
+		let mut stream = TcpStream::connect(addr).await.map_err(Error::FiletransferIo)?;
+		stream.write_all(key.as_bytes()).await.map_err(Error::FiletransferIo)?;
+		stream.flush().await.map_err(Error::FiletransferIo)?;
+		Ok(stream)
+	}).await.map_err(|_| Error::FiletransferIo(std::io::Error::new(std::io::ErrorKind::TimedOut,"file transfer timed out")))?
 }
 
