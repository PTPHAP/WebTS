{
  "name": "web-ts-client",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/audio-assets.mjs && node scripts/crypto-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "pretest": "node scripts/audio-assets.mjs && node scripts/crypto-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "prebuild": "node scripts/audio-assets.mjs && node scripts/crypto-assets.mjs",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
