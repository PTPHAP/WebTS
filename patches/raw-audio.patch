+	fn from_tomcrypt_scalar(value: &BigInt) -> Result<Self> {
+		let (sign, bytes) = value.to_bytes_be();
+		if sign != Sign::Plus || bytes.len() > 32 {
+			return Err(Error::NoShortKey);
+		}
+		// ASN.1 integers omit leading zeros; P-256 scalars require all 32 bytes.
+		let mut scalar = [0u8; 32];
+		scalar[32 - bytes.len()..].copy_from_slice(&bytes);
+		Self::from_short(&scalar)
+	}
+
 	/// Convert to base64 encoded private tomcrypt key.
 	pub fn to_ts(&self) -> String { BASE64_STANDARD.encode(self.to_tomcrypt()) }
 
