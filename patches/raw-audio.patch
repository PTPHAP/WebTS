+use std::{collections::HashMap,net::{IpAddr,SocketAddr},time::{Duration,Instant}};
+pub(crate) fn resolve_filetransfer_addr(
+	reported_ip: Option<IpAddr>, reported_port: u16, voice_peer: SocketAddr,
+	fallback_port: u16,
+) -> SocketAddr {
+	// WebTS avatars may only contact the already validated voice server IP.
+	let _ = reported_ip;
+	let ip = voice_peer.ip();
+	let port = if reported_port == 0 || reported_port == voice_peer.port() {
+		fallback_port
+	} else {
+		reported_port
+	};
+	SocketAddr::new(ip, port)
+}
+
+
+pub(crate) fn take_request(requests:&mut HashMap<u16,(bool,Instant)>,id:u16,upload:bool)->bool {
+    requests.remove(&id).is_some_and(|(direction,time)|direction==upload&&time.elapsed()<Duration::from_secs(10))
+}
+#[cfg(test)] mod tests {
+use super::*;
+#[test] fn remote_notifications_cannot_redirect_tcp_to_other_hosts(){
+ let peer="8.8.8.8:9987".parse().unwrap();
+ for redirect in ["127.0.0.1","169.254.169.254","10.0.0.1","1.1.1.1","::1"] {
+  assert_eq!(resolve_filetransfer_addr(Some(redirect.parse().unwrap()),30034,peer,30033),"8.8.8.8:30034".parse().unwrap());
+ }
+ assert_eq!(resolve_filetransfer_addr(None,0,peer,30033).port(),30033);
+}
+#[test] fn notifications_require_unexpired_matching_request_once(){
+ let mut requests=HashMap::new();assert!(!take_request(&mut requests,1,false));
+ requests.insert(1,(false,Instant::now()));assert!(take_request(&mut requests,1,false));assert!(!take_request(&mut requests,1,false));
+ requests.insert(2,(true,Instant::now()));assert!(!take_request(&mut requests,2,false));
+ requests.insert(3,(false,Instant::now()-Duration::from_secs(11)));assert!(!take_request(&mut requests,3,false));
+}
+}
